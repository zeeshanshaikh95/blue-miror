# Public browser configuration only. Never place secrets in VITE_* variables.

# Base URL of the Blue Miror API, including /api.
VITE_API_BASE_URL=http://localhost:4000/api

# Canonical public site origin, used by SEO metadata.
VITE_SITE_URL=http://localhost:5173

# Keep false until clinic content, photography and legal pages are approved.
VITE_ALLOW_INDEXING=false

# Public Cloudinary cloud name, used for responsive delivery URLs.
VITE_CLOUDINARY_CLOUD_NAME=
