# Server runtime
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
TRUST_PROXY=0
REQUEST_BODY_LIMIT=100kb

# MongoDB — use a dedicated Blue Miror database and user.
MONGODB_URI=mongodb://127.0.0.1:27017/blue-miror

# Authentication secrets — generate unique values, never reuse another project's.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_ISSUER=blue-miror-api
JWT_AUDIENCE=blue-miror-admin
ADMIN_BOOTSTRAP_SECRET=

# Admin session lifetime in minutes (JWT expiry and session document TTL).
ADMIN_SESSION_TTL_MINUTES=60

# Admin login protection. Dedicated limiter, stricter than the general API limit.
# Per-account attempts before a lockout, per-IP attempts, sliding window, and the
# base lockout duration (doubles on repeated lockouts, capped at 8x).
ADMIN_LOGIN_MAX_ATTEMPTS=5
ADMIN_LOGIN_IP_MAX_ATTEMPTS=20
ADMIN_LOGIN_WINDOW_SECONDS=900
ADMIN_LOGIN_LOCKOUT_SECONDS=900

# Exact browser origins allowed to call the API (comma-separated, no trailing slash).
CORS_ORIGINS=http://localhost:5173

# Cloudinary — required in production; optional for Phase 2 health checks in development.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER_PREFIX=blue-miror
